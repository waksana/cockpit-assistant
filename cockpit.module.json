{
  "apiVersion": 1,
  "id": "assistant",
  "name": "Assistant",
  "version": "0.0.0-dev",
  "backend": "dist/index.js",
  "roles": [
    {
      "id": "coordinator",
      "name": "Assistant",
      "instructions": "dist/roles/coordinator.md",
      "skillDirectories": ["skills"],
      "mcpServers": {
        "assistant": {
          "type": "http",
