{
  "apiVersion": 1,
  "id": "assistant",
  "name": "Assistant",
  "version": "0.0.0-dev",
  "backend": "dist/index.js",
  "frontend": {
    "entry": "dist/web/index.js",
    "styles": ["dist/web/styles.css"],
    "assets": ["dist/web"]
  },
  "roles": [
    {
      "id": "coordinator",
      "name": "coordinator",
      "instructions": "roles/coordinator.md",
      "mcpServers": {
        "assistant": {
          "type": "http",
          "path": "/mcp",
          "tools": ["assistant_topics", "assistant_topic", "assistant_map", "assistant_sessions", "assistant_history", "assistant_dispatch", "assistant_attribute", "assistant_clarify"]
        }
      }
    },
    {
      "id": "memory",
      "name": "memory",
      "instructions": "roles/memory.md",
      "mcpServers": {
        "assistant": {
          "type": "http",
          "path": "/mcp",
          "tools": ["assistant_memory_read", "assistant_memory_claim", "assistant_remember"]
        }
      }
    }
  ]
}
