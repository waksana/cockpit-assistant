{
  "apiVersion": 1,
  "id": "assistant",
  "name": "Assistant",
  "version": "0.1.0",
  "backend": "dist/index.js",
  "roles": [
    {
      "id": "coordinator",
      "name": "Assistant coordinator",
      "instructions": "roles/coordinator.md",
      "mcpServers": {
        "assistant": {
          "type": "http",
          "path": "/mcp",
          "tools": ["assistant_read", "assistant_claim", "assistant_decide"]
        }
      }
    },
    {
      "id": "memory",
      "name": "Assistant memory",
      "instructions": "roles/memory.md",
      "mcpServers": {
        "assistant": {
          "type": "http",
          "path": "/mcp",
          "tools": ["assistant_read", "assistant_claim", "assistant_remember"]
        }
      }
    }
  ]
}
