{
  "apiVersion": 1,
  "id": "assistant",
  "name": "Assistant",
  "version": "0.0.0-dev",
  "backend": "dist/index.js",
  "frontend": {
    "entry": "dist/web/index.js",
    "styles": ["dist/web/styles.css"],
    "assets": ["dist/web"]
  },
  "roles": [
    {
      "id": "coordinator",
      "name": "coordinator",
      "instructions": "dist/roles/coordinator.md",
      "skillDirectories": ["skills"],
      "mcpServers": {
        "assistant": {
          "type": "http",
          "path": "/mcp",
          "tools": ["assistant_topics", "assistant_topic", "assistant_dispatch", "assistant_status", "assistant_inbox", "assistant_history", "assistant_source"]
        }
      }
    },
    {
      "id": "organizer",
      "name": "Topic organizer",
      "instructions": "dist/roles/organizer.md",
      "skillDirectories": ["skills"],
      "mcpServers": {
        "assistant": {
          "type": "http",
          "path": "/mcp",
          "tools": ["assistant_topics", "assistant_topic", "assistant_sessions", "assistant_history"]
        }
      }
    },
    {
      "id": "worker",
      "name": "Topic worker",
      "instructions": "roles/worker.md"
    }
  ]
}
