{
  "name": "@waksana/cockpit-assistant",
  "version": "0.0.0-dev",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "files": [
    "dist",
    "roles",
    "licenses",
    "cockpit.module.json",
    "README.md",
    "docs"
  ],
  "scripts": {
    "build": "tsc --noEmit && node scripts/build.mjs",
    "test": "npm run test:prepare && node --import tsx --test test/*.test.ts",
    "test:prepare": "node scripts/test-prepare.mjs",
    "check": "tsc --noEmit",
    "test:browser": "node scripts/browser-build.mjs && playwright test",
    "pack:check": "node scripts/pack-check.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@types/node": "24.10.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@waksana/cockpit-module-sdk": "0.11.1",
    "esbuild": "0.25.12",
    "lucide-react": "1.46.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-router-dom": "7.18.3",
    "sass": "1.104.0",
    "tsx": "4.21.0",
    "typescript": "5.9.3"
  },
  "dependencies": {
    "zod": "4.1.13"
  }
}
